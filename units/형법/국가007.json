    {"i":"19w58wh","o":"<div class=\"cs-li cs-bul\" style=\"margin-left:0px\">","h":"① 뇌물공여죄에는 특가법 <span class=\"cs-blue\"><span class=\"cs-u\">제2조</span> 제1항</span> 적용<span class=\"cs-x\"><strong>(X)</strong></span>","k":"10lzb67"},
    {"i":"vddcb4","o":"<div class=\"cs-li cs-bul\" style=\"margin-left:0px\">","h":"② 丙 = 뇌물공여죄(<span class=\"cs-blue\"><span class=\"cs-u\">제133조</span> 제1항</span>) <span class=\"cs-blue\">!-- 교정: 원문 '乙은 뇌물공여죄' → 문맥상 '丙은' --</span>","k":"1yj9f50"},
