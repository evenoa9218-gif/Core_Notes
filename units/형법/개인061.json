    {"i":"1k1gacf","o":"<div class=\"cs-li cs-bul\" style=\"margin-left:16px\">","h":"③ 근저당권설정등기로 배임죄가 성립하는 경우 이득액 = 담보되는 '피담보채무' 상당액","k":"e0u037"},
