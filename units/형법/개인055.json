    {"i":"lhmyiq","o":"<div class=\"cs-li cs-bul\" style=\"margin-left:16px\">","h":"② 甲에게 사기죄(<span class=\"cs-blue\"><span class=\"cs-u\">제347조</span> 제1항</span>)<span class=\"cs-x\"><strong>(X)</strong></span>","k":"14r6o8m"},
