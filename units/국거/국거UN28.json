{"id":"국거UN28","t":"매수인의 계약위반에 대한 구제 · 계약해제","cat":"UN협약 · 제3편 제3장 매수인의 의무","lv":1,"tg":[],"b":[
 {"i":"국거UN28-001","o":"<div class=\"cs-h\" data-lv=\"2\">","h":"Ⅰ. 계약해제권","k":"fgghau"},
