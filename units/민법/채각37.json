 {"i":"1rrx9gx","o":"<div class=\"cs-li\" style=\"margin-left:0px\">","h":"1. 계약의 종류","k":"17vaxdy"},
 {"i":"19yrhfj","o":"<div class=\"cs-li cs-bul\" style=\"margin-left:0px\">","h":"<span class=\"cs-hl\">쌍무계약은 모두 유상계약</span> (소비대차·위임·임치·종신정기금은 유상인 경우 쌍무)","k":"afvei2"},
 {"i":"8f8qa4","o":"<div class=\"cs-li cs-bul\" style=\"margin-left:0px\">","h":"<span class=\"cs-hl\">현상광고는 편무+유상계약</span>","k":"vp57ei"},
 {"i":"1bwz433","o":"<div class=\"cs-li cs-bul\" style=\"margin-left:0px\">","h":"<span class=\"cs-hl\"><strong>요물계약</strong></span>: 현상광고, 대물변제계약, 계약금계약, 보증계약","k":"19z0zyv"},
 {"i":"10qfkyv","o":"<div class=\"cs-li\" style=\"margin-left:0px\">","h":"2. 계약의 성립","k":"1idf6j8"},
