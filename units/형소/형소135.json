{"id":"형소135","t":"약식명령과 이에 대한 정식재판청구절차","cat":"pro_21","lv":1,"tg":["下"],"b":[
 {"i":"o3ttnw","o":"<details class=\"cs-case\">","b":[
  {"i":"1un2ggf","o":"<summary>","h":"<span class=\"cs-u\"><strong>[CASE(1)] 정식재판절차에서 벌금 증액 선고의 적법성</strong></span>","k":"k3qr6i"},
